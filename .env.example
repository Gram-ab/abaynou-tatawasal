# Local development only. Generated values belong in ignored .env.local.
# Runtime uses a generated restricted login; never use a database-owner password here.
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_COOKIE_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
APP_ENV=local
